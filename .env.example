# Copy to .env and change every value marked CHANGE_ME.
POSTGRES_PASSWORD=CHANGE_ME_db_password
# Any long random string, e.g. `openssl rand -hex 32`. Changing it later makes
# stored API keys unreadable (re-enter them in Admin → Providers).
AIW_SECRET_KEY=CHANGE_ME_long_random_secret
AIW_ADMIN_USERNAME=admin
AIW_ADMIN_PASSWORD=CHANGE_ME_admin_password
AIW_ALLOW_REGISTRATION=false
AIW_COOKIE_SECURE=false
AIW_PORT=8080

# Only needed if a mounted config.yaml references them.
OPENAI_API_KEY=
GEMINI_API_KEY=
